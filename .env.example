# Stockage durable hors du dépôt, identique pour daily.py et session_local.py.
OUAGA_PERSISTENT_DIR=C:/ouaga-etl-data
# Dossier protégé sur un autre disque ou une destination de sauvegarde.
OUAGA_BACKUP_DIR=
# Renseigner localement, ne jamais publier ces valeurs.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=require
OPENAI_API_KEY=
# Cookies : préférer scripts/session_local.py, qui écrit uniquement en local.
# Les anciennes variables PROXY_URL sont ignorées.
BROWSER_LOCALE=fr-FR
BROWSER_TIMEZONE=Africa/Ouagadougou
