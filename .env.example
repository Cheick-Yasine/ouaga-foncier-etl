# Copier ce fichier en ".env" pour une exécution locale (ne jamais committer le .env réel).
# En CI (GitHub Actions), ces valeurs sont injectées via les "secrets" du repo, pas via ce fichier.

# Cookies de session Facebook exportés (format JSON, liste d'objets cookie Playwright).
# Exemple de structure attendue : [{"name": "c_user", "value": "...", "domain": ".facebook.com", ...}, ...]
FB_COOKIES_JSON=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Base de données maître PostgreSQL (source de vérité, upsert par id de post).
# Format standard libpq : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Exemple pour une instance locale : postgresql://postgres:motdepasse@localhost:5432/ouaga_foncier_etl
DATABASE_URL=

# Uniquement pour lancer la suite de tests en local (tests/test_processor_db.py) :
# base PostgreSQL séparée, jamais la même que DATABASE_URL (les tests font des
# DROP TABLE entre chaque test - ne JAMAIS pointer ceci vers une base réelle).
# Si absente, les tests qui en dépendent sont automatiquement skippés.
TEST_DATABASE_URL=
