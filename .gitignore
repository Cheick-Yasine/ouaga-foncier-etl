# Secrets / environnement
.env
*.env.local

# Données scrapées (peuvent contenir des données personnelles - ne jamais versionner)
data/raw/
data/processed/
data/state/
data/logs/
*.csv
*.json
!tests/fixtures/*.json
!groups.csv

# Artefacts pytest occasionnels (basetemp créé dans le cwd selon l'environnement)
pytest-cache-files-*

# Playwright
node_modules/
playwright-report/
test-results/

# Dumps HTML "Afficher le code source" (contiennent de vraies données
# personnelles de tiers - numéros de téléphone dans les posts - jamais versionnés)
view-source_*.html
*.html

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / éditeurs
.DS_Store
.vscode/
